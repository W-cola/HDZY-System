# API runtime
PORT=5320
NITRO_HOST=0.0.0.0
NITRO_PORT=5320

# Required in production; use two different random secrets
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret

# First initialization only; existing admin password is never overwritten
INITIAL_ADMIN_PASSWORD=replace-with-first-admin-password

# Optional: use hosted PostgreSQL instead of local PGlite
# DATABASE_URL=postgresql://user:password@host:5432/database
PGLITE_DATA_DIR=../../data/pg

# Optional comma-separated browser origins
LUFFY_PREVIEW_ORIGINS=
CORS_ORIGINS=http://localhost:5173
